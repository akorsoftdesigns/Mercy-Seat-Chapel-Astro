---
/* Banner at the top of inner pages: photo, breadcrumbs, the page's one <h1>, and an
   optional intro paragraph (put it between <PageHero> and </PageHero>).

   <PageHero title="Privacy Policy" image="assets/images/hero-privacy.webp"
             crumbs={[{ label: "Home", href: "index.html" }, { label: "Privacy Policy" }]}>
     <p>Intro text</p>
   </PageHero>

   imageLabel: describe the photo for screen readers when it carries meaning (leave out for decorative photos).
   imagePosition: CSS background-position, e.g. "65% center", to keep the subject in view. */
interface Crumb { label: string; href?: string }
interface Props { title: string; image: string; imageLabel?: string; imagePosition?: string; crumbs: Crumb[] }
const { title, image, imageLabel, imagePosition, crumbs } = Astro.props;
const bgStyle = `background-image:url('${image}')${imagePosition ? `; background-position:${imagePosition}` : ""}`;
---
<section class="page-hero">
  <div class="page-hero__bg" role={imageLabel ? "img" : undefined} aria-label={imageLabel} style={bgStyle}></div>
  <div class="container">
    <ol class="crumbs">{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}</ol>
    <h1>{title}</h1>
    <slot />
  </div>
</section>
