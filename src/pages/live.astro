---
/* Watch Live. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import { regions } from "../lib/cms.js"; // dashboard sections: live-schedule, recent-livestreams
---
<BaseLayout
  page="live.html"
  title="Watch Live"
  description="Watch Mercy Seat Chapel services live online: Sundays at 10:00 AM and Tuesday Bible Study at 7:30 PM."
  image="assets/images/hero-5.jpg"
>
  <section class="page-hero">
    <div class="page-hero__bg" style="background-image:url('assets/images/hero-5.jpg')"></div>
    <div class="container">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li>Sermons</li><li>Watch Live</li></ol>
      <h1>Watch the Latest Sermon</h1>
      <p>All services take place in our main auditorium and are streamed live. Join us online wherever you are.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal reveal--zoom">
        <!-- data-live: plays on this page the live stream, or if nothing is live, the most recent livestream
             (picked automatically with the YouTube API; see SITE.liveVideoId). data-id is only the first thumbnail shown while the page loads. -->
        <div class="yt yt--rounded" data-live data-id="DEQygtr16JM" data-title="MSC Livestream" style="box-shadow:var(--shadow-md)"></div>
      </div>
      <!-- Opens the channel's current live stream on YouTube (link set in Site Settings in the dashboard) -->
      <div class="btn-row reveal" style="margin-top:20px"><a class="btn btn--outline" data-site="youtube-live" data-brand="youtube" href="#" target="_blank" rel="noopener">Watch on YouTube</a></div>
      <div class="notice reveal" style="margin-top:20px"><i data-lucide="info"></i><p>Press play to join the current livestream. If we’re not live right now, the player shows our most recent livestream. More past services are below.</p></div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">Live schedule</span><h2>When we stream</h2></div>
      <!-- Managed in the dashboard (Homepage → Watch Live page: “When we stream” cards) -->
      <div class="grid grid--3">
        <Fragment set:html={regions["live-schedule"]} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div><span class="eyebrow">Replay</span><h2>Recent livestreams</h2></div>
        <a class="btn btn--outline" href="sermons.html">Latest Messages <i data-lucide="arrow-right"></i></a>
      </div>
      <!-- data-youtube-grid="4" + data-youtube-source="streams": these cards are replaced with the 4 newest live streams from the channel's YouTube "Live" tab (skipping the one in the player above). The cards below are only the fallback shown if the feed can't be reached. -->
      <div class="grid grid--4" data-youtube-grid="4" data-youtube-source="streams">
        <Fragment set:html={regions["recent-livestreams"]} />
      </div>
    </div>
  </section>
</BaseLayout>
