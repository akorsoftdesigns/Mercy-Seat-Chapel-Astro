---
/* Watch Live. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import { regions } from "../lib/cms.js"; // sections: livestream-tabs, recent-livestreams
---
<BaseLayout
  page="live.html"
  title="Watch Live"
  description="Watch Mercy Seat Chapel services live online: Sundays at 10:00 AM and Tuesday Bible Study at 7:30 PM."
  image="assets/images/hero-5.jpg"
>
  <section class="page-hero">
    <div class="page-hero__bg" style="background-image:url('assets/images/hero-5.jpg')"></div>
    <div class="container">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li>Sermons</li><li>Watch Live</li></ol>
      <h1>Watch the Latest Sermon</h1>
      <p>All services take place in our main auditorium and are streamed live. Join us online wherever you are.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal reveal--zoom">
        <!-- data-live: plays on this page the live stream, or if nothing is live, the most recent livestream
             (picked automatically with the YouTube API; see SITE.liveVideoId). data-id is only the first thumbnail shown while the page loads. -->
        <div class="yt yt--rounded" data-live data-id="DEQygtr16JM" data-title="MSC Livestream" style="box-shadow:var(--shadow-md)"></div>
      </div>
      <!-- Opens the channel's current live stream on YouTube (link set in Site Settings in the dashboard) -->
      <div class="btn-row reveal" style="margin-top:20px"><a class="btn btn--outline" data-site="youtube-live" data-brand="youtube" href="#" target="_blank" rel="noopener">Watch on YouTube</a></div>
      <div class="notice reveal" style="margin-top:20px"><i data-lucide="calendar-clock"></i>
        <div class="notice__text">
          <!-- The "When we stream" line was removed (Nov 2026); to restore it, add a Fragment with set:html of regions["live-schedule-note"] here -->
          <p>Press play to join the current livestream. If we’re not live right now, the player shows our most recent livestream. More past services are below.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div><span class="eyebrow">Replay</span><h2>Messages &amp; Services</h2></div>
        <a class="btn btn--outline" href="sermons.html">Latest Messages <i data-lucide="arrow-right"></i></a>
      </div>
      <!-- Filter buttons: "All" (newest livestreams) and the channel's YouTube playlists, Sunday Service
           first, then by newest video. Cards open on YouTube in a new tab. -->
      <div class="place__tabs place__tabs--light reveal" role="group" aria-label="Filter livestreams by playlist" data-filters="#livestream-cards">
        <Fragment set:html={regions["livestream-tabs"]} />
      </div>
      <div class="grid grid--4" id="livestream-cards" data-per="8">
        <Fragment set:html={regions["recent-livestreams"]} />
      </div>
      <!-- "Show more": 8 more videos of the chosen button at a time, to the last one (the full lists are in
           data-source, loaded on the first press); hidden when there are no more (main.js initVideoFilters) -->
      <div class="text-center" style="margin-top:40px"><button class="btn btn--outline" type="button" data-more="#livestream-cards" data-source="assets/data/youtube-playlists.json" data-fallback="assets/data/youtube-streams.json" hidden>Show more <i data-lucide="chevron-down"></i></button></div>
    </div>
  </section>
</BaseLayout>
