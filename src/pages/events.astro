---
/* Events. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { regions } from "../lib/cms.js"; // dashboard sections: events-regular, events-seasonal, upcoming-events
---
<BaseLayout
  page="events.html"
  title="Events"
  description="Weekly services, monthly gatherings and annual events at Mercy Seat Chapel, including Seeking His Presence, Angel Treat and the Annual Turkey Drive."
  image="assets/images/church-1716.jpg"
>
  <PageHero
    title="Events"
    image="assets/images/church-1716.jpg"
    crumbs={[{"label":"Home","href":"index.html"},{"label":"Events"}]}
  >
    <p>There’s always something happening at Mercy Seat Chapel. See what’s coming up and make plans to join us.</p>
  </PageHero>

  <section class="section section--soft" id="upcoming">
    <div class="container">
      <div class="section-head section-head--left reveal">
        <span class="eyebrow">Upcoming Events</span>
        <h2>What’s happening at MSC</h2>
      </div>
      <!-- Events slider: shared with the homepage. Edit the events in the dashboard (Events, Announcements) -->
      <Fragment set:html={regions["upcoming-events"]} />
    </div>
  </section>

  <section class="section section--white" id="regular" style="scroll-margin-top:40px">
    <div class="container">
      <div class="section-head section-head--left reveal">
        <span class="eyebrow">Weekly &amp; monthly</span>
        <h2>Service Times</h2>
      </div>
      <!-- Managed in the dashboard (Events & Programs → Regular gatherings). The homepage "See all service times" button links here (#regular). -->
      <div class="event-list">
        <Fragment set:html={regions["events-regular"]} />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--left reveal">
        <span class="eyebrow">Annual</span>
        <h2>Seasonal outreaches</h2>
      </div>
      <!-- Managed in the dashboard (regular gatherings that repeat every year) -->
      <div class="grid grid--3">
        <Fragment set:html={regions["events-seasonal"]} />
      </div>
      <div class="notice reveal" style="margin-top:32px"><i data-lucide="calendar-check"></i><p>Dates for seasonal events are announced at church and on our social media. Follow us on <a data-site="instagram" href="#" target="_blank" rel="noopener">Instagram</a>, <a data-site="facebook" href="#" target="_blank" rel="noopener">Facebook</a>, <a data-site="twitter" href="#" target="_blank" rel="noopener">X (Twitter)</a> and <a data-site="tiktok" href="#" target="_blank" rel="noopener">TikTok</a> for the latest updates.</p></div>
    </div>
  </section>
</BaseLayout>
