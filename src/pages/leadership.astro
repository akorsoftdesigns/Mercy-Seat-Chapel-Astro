---
/* Leadership. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { regions } from "../lib/cms.js"; // dashboard sections: leaders
---
<BaseLayout
  page="leadership.html"
  title="Leadership"
  description="Meet the Senior Pastors and ministers who serve and lead the Mercy Seat Chapel family."
  image="assets/images/pastors.jpg"
  imageAlt="The pastors of Mercy Seat Chapel"
>
  <PageHero
    title="Our Leadership"
    image="assets/images/pastors.jpg"
    crumbs={[{"label":"Home","href":"index.html"},{"label":"About","href":"about.html"},{"label":"Leadership"}]}
  >
    <p>The pastors and ministers who serve, shepherd and lead the Mercy Seat Chapel family.</p>
  </PageHero>

  <!-- Senior Pastors -->
  <section class="section section--soft" id="senior-pastors">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Senior Pastors</span>
        <h2>Shepherding the <em>flock</em></h2>
      </div>
      <!-- Managed in the dashboard (Leadership): the same entries as the About page -->
      <div style="display:grid; gap:28px">
        <Fragment set:html={regions["leaders"]} />
      </div>
    </div>
  </section>

  <!-- Ministers
       Order: Pastors, then Assistant Pastors (if any), Deacons & Deaconesses, then Ministers.
       To add someone: copy one <li> block into their group, change the photo, name and portfolio.
       Photos go in assets/images/leadership/ (square, about 600×600).
       Anyone without a portfolio yet shows "Minister".
       No photo yet: use assets/images/leadership/placeholder-male.jpg or placeholder-female.jpg
       with alt "Photo coming soon: Name". -->
  <section class="section section--white" id="ministers">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Ministers in Charge</span>
        <h2>Serving with <em>grace</em></h2>
        <p>Our pastors, ministers, deacons and deaconesses lead the ministries and departments of the church.</p>
      </div>
      <ul class="ministers">
        <li class="minister reveal">
          <img src="assets/images/leadership/pst-adeyinka-are.jpg" alt="Pst. Adeyinka Are" width="600" height="600" loading="lazy">
          <h3>Pst. Adeyinka Are</h3>
          <p class="minister__role">Drama</p>
        </li>
        <li class="minister reveal" style="--d:.06s">
          <img src="assets/images/leadership/pst-patricia-anyakwo.jpg" alt="Pst. Patricia Anyakwo" width="600" height="600" loading="lazy">
          <h3>Pst. Patricia Anyakwo</h3>
          <p class="minister__role">Evangelism &amp; Hospitality</p>
        </li>
        <!-- Placeholder photo: replace src with this person's photo, e.g. assets/images/leadership/pst-anosike-nwokoye.jpg -->
        <li class="minister reveal" style="--d:.12s">
          <img src="assets/images/leadership/placeholder-male.jpg" alt="Photo coming soon: Pst. Anosike Nwokoye" width="600" height="600" loading="lazy">
          <h3>Pst. Anosike Nwokoye</h3>
          <p class="minister__role">MSC Kidz &amp; MSC Teens</p>
        </li>
        <!-- Placeholder photo -->
        <li class="minister reveal" style="--d:.18s">
          <img src="assets/images/leadership/placeholder-female.jpg" alt="Photo coming soon: Pst. Toyin Omola" width="600" height="600" loading="lazy">
          <h3>Pst. Toyin Omola</h3>
          <p class="minister__role">Prayer</p>
        </li>
        <!-- Deacons & Deaconesses -->
        <li class="minister reveal">
          <img src="assets/images/leadership/dcn-lekan-abioye.jpg" alt="Dcn. ’Lekan Abioye" width="600" height="600" loading="lazy">
          <h3>Dcn. ’Lekan Abioye</h3>
          <p class="minister__role">Media &amp; Communication</p>
        </li>
        <!-- Placeholder photo -->
        <li class="minister reveal" style="--d:.06s">
          <img src="assets/images/leadership/placeholder-male.jpg" alt="Photo coming soon: Dcn. Adedayo Kemiki" width="600" height="600" loading="lazy">
          <h3>Dcn. Adedayo Kemiki</h3>
          <p class="minister__role">Sunday School</p>
        </li>
        <!-- Placeholder photo -->
        <li class="minister reveal" style="--d:.12s">
          <img src="assets/images/leadership/placeholder-male.jpg" alt="Photo coming soon: Dcn. George Oyedele" width="600" height="600" loading="lazy">
          <h3>Dcn. George Oyedele</h3>
          <p class="minister__role">Parking &amp; Traffic Control, Transportation</p>
        </li>
        <li class="minister reveal" style="--d:.18s">
          <img src="assets/images/leadership/dcns-abiola-akinyosoye.jpg" alt="Dcns. Abiola Akinyosoye" width="600" height="600" loading="lazy">
          <h3>Dcns. Abiola Akinyosoye</h3>
          <p class="minister__role">Welcome &amp; Follow-Up</p>
        </li>
        <li class="minister reveal">
          <img src="assets/images/leadership/dcns-kenny-soile.jpg" alt="Dcns. Kenny Soile" width="600" height="600" loading="lazy">
          <h3>Dcns. Kenny Soile</h3>
          <p class="minister__role">Accounts &amp; Treasury</p>
        </li>
        <li class="minister reveal" style="--d:.06s">
          <img src="assets/images/leadership/dcns-nike-oyeyiola.jpg" alt="Dcns. Nike Oyeyiola" width="600" height="600" loading="lazy">
          <h3>Dcns. Nike Oyeyiola</h3>
          <p class="minister__role">Workers &amp; Believers Academy</p>
        </li>
        <li class="minister reveal" style="--d:.12s">
          <img src="assets/images/leadership/dcns-roseline-ubadike.jpg" alt="Dcns. Roseline Ubadike" width="600" height="600" loading="lazy">
          <h3>Dcns. Roseline Ubadike</h3>
          <p class="minister__role">Sanitation</p>
        </li>
        <li class="minister reveal" style="--d:.18s">
          <img src="assets/images/leadership/dcns-toyin-kemiki.jpg" alt="Dcns. Toyin Kemiki" width="600" height="600" loading="lazy">
          <h3>Dcns. Toyin Kemiki</h3>
          <p class="minister__role">Welfare</p>
        </li>
        <!-- Ministers -->
        <!-- Placeholder photo -->
        <li class="minister reveal">
          <img src="assets/images/leadership/placeholder-female.jpg" alt="Photo coming soon: Min. Simi Onafuwa" width="600" height="600" loading="lazy">
          <h3>Min. Simi Onafuwa</h3>
          <p class="minister__role">Sales</p>
        </li>
        <li class="minister reveal" style="--d:.06s">
          <img src="assets/images/leadership/min-temitope-alade.jpg" alt="Min. Temitope Alade" width="600" height="600" loading="lazy">
          <h3>Min. Temitope Alade</h3>
          <p class="minister__role">Information Technology</p>
        </li>
        <li class="minister reveal" style="--d:.12s">
          <img src="assets/images/leadership/min-toyin-ladipo.jpg" alt="Min. Toyin Ladipo" width="600" height="600" loading="lazy">
          <h3>Min. Toyin Ladipo</h3>
          <p class="minister__role">Ushering</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2>We can’t wait to meet you</h2>
          <p>Join us on Sundays at 10:00 AM in person, or worship with us online.</p>
        </div>
        <div class="btn-row"><a class="btn btn--primary" href="plan-a-visit.html">Plan a Visit</a><a class="btn btn--outline-light" href="first-timer.html">I’m a First Time Guest</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
