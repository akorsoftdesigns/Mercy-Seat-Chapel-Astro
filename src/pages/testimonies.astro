---
/* Testimonies. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout
  page="testimonies.html"
  title="Testimonies"
  description="Share a testimony of what God has done in your life, or share your prayer request with Mercy Seat Chapel."
  image="assets/images/church-1705.jpg"
>
  <PageHero
    title="Testimonies"
    image="assets/images/hero-4.jpg"
    crumbs={[{"label":"Home","href":"index.html"},{"label":"Testimonies"}]}
  >
    <p>“They triumphed over him by the blood of the Lamb and by the word of their testimony.” (Revelation 12:11)</p>
  </PageHero>

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="reveal reveal--left">
        <span class="eyebrow">Share a Testimony</span>
        <h2>What has God done for you?</h2>
        <p class="lead">Your story of God’s faithfulness can strengthen someone else’s faith. Share your testimony and let us celebrate with you.</p>
        <div class="grid grid--2" style="gap:16px; margin-top:28px">
          <div class="icon-card"><div class="icon-card__icon"><i data-lucide="sparkles"></i></div><h3 style="font-size:18px">Celebrate</h3><p>Give God the glory for answered prayer.</p></div>
          <div class="icon-card"><div class="icon-card__icon"><i data-lucide="hand-heart"></i></div><h3 style="font-size:18px">Encourage</h3><p>Inspire someone who is still waiting.</p></div>
        </div>
        <div class="notice" style="margin-top:24px"><i data-lucide="heart"></i><p>Need prayer instead? <a href="contact.html#prayer">Share your Prayer Request</a> with our pastoral team.</p></div>
      </div>
      <form class="form-card reveal reveal--right" id="testimony-form" style="scroll-margin-top:110px" data-demo novalidate>
        <h3 style="font-size:24px">Share a Testimony</h3>
        <div style="display:grid; gap:20px; margin-top:20px">
          <div class="field"><label for="ts-name">Name <span class="req">*</span></label><input id="ts-name" name="name" autocomplete="name" required></div>
          <div class="field"><label for="ts-email">Email <span class="req">*</span></label><input id="ts-email" name="email" type="email" autocomplete="email" required></div>
          <div class="field"><label for="ts-msg">Your testimony <span class="req">*</span></label><textarea id="ts-msg" name="testimony" required></textarea></div>
          <label class="choice"><input type="checkbox" name="share_ok" value="yes"><span>You may share my testimony on the website</span></label>
        </div>
        <button class="btn btn--secondary" type="submit" style="margin-top:24px">Submit testimony</button>
        <p class="form-note">Testimonies are only shared on the website if you tick the box above. See our <a href="privacy.html">Privacy Policy</a>.</p>
        <div class="form-success" role="status" tabindex="-1">Thank you for sharing what God has done!</div>
      </form>
    </div>
  </section>
</BaseLayout>
