---
/* Latest Messages. Page text is plain HTML below; the shared head, header and footer come from BaseLayout. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { regions } from "../lib/cms.js"; // sections: sermon-feature (newest finished MSC Sermons message), teaching-series (MSC Sermons livestreams)
---
<BaseLayout
  page="sermons.html"
  title="Latest Messages"
  description="Watch the latest sermons, services and messages from Mercy Seat Chapel."
  image="assets/images/multimedia.jpg"
>
  <PageHero
    title="Latest Messages"
    image="assets/images/multimedia.jpg"
    crumbs={[{"label":"Home","href":"index.html"},{"label":"Sermons"},{"label":"Latest Messages"}]}
  >
    <p>Sunday may be over, but the Word doesn’t have to stop. Watch recent services, teachings and special programs anytime.</p>
  </PageHero>

  <section class="section">
    <div class="container">
      <!-- No buttons on this page lead to YouTube (the "Subscribe on YouTube" button was removed, Nov 2026) -->
      <div class="section-head section-head--left reveal">
        <span class="eyebrow">Featured</span><h2>Latest message</h2>
      </div>
      <!-- Main player: the newest finished message from the Teaching series list below (never a live or
           scheduled stream). Any Teaching series thumbnail below also plays here (data-plays-in="#sermon-player"). -->
      <div class="video-feature reveal" id="sermon-player">
        <Fragment set:html={regions["sermon-feature"]} />
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--left reveal">
        <span class="eyebrow">Teaching series</span>
        <h2>More messages</h2>
      </div>
      <!-- The newest livestreams from the MSC Sermons YouTube channel (sermonsChannelId in src/data/site.js),
           most recent first. Clicking a thumbnail plays it in the main player above, on this page. -->
      <!-- The page holds the newest 8 (2 rows of 4 on wide screens); "Show more" adds 8 at a time from
           assets/data/youtube-sermons.json until every message is shown (main.js initMoreVideos) -->
      <div class="grid grid--4" id="teaching-cards" data-per="8" data-plays-in="#sermon-player">
        <Fragment set:html={regions["teaching-series"]} />
      </div>
      <!-- "See all services" (to YouTube) was replaced by this button, Nov 2026 -->
      <div class="text-center" style="margin-top:40px"><button class="btn btn--outline" type="button" data-more="#teaching-cards" data-source="assets/data/youtube-sermons.json" data-name="MSC Sermons" hidden>Show more <i data-lucide="chevron-down"></i></button></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band reveal">
        <div><h2>Worship with us live</h2><p>Sunday Service at 10:00 AM and Bible Study on Tuesdays at 7:30 PM are streamed live.</p></div>
        <div class="btn-row"><a class="btn btn--primary" href="live.html"><i data-lucide="radio"></i> Watch Live</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
